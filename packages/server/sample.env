DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres
ROUTES_PREFIX=/api
# CORS allowed origin(s) for the public API. "*" (default) keeps charts embeddable
# anywhere; set a single origin or a comma-separated list to restrict it.
CORS_ORIGIN="*"
# Public chart/dashboard publishing. "false" removes this instance's public
# surface: /charts/show/:id and /dashboards/show/:id stop answering, nothing can
# be set to publish: true, and the webapp hides the publish UI accordingly
# (it reads this value from GET /api/config). Anything else keeps it enabled.
ENABLE_PUBLIC_PUBLISHING="true"
# Email/password authentication. "false" makes SPID/CIE (OIDC) the only way to
# log in and sign up: the password endpoints under /auth answer 403, the OIDC
# signup stops asking for a password, and the webapp shows only the SPID/CIE
# button (it reads this value from GET /api/config). Anything else keeps it enabled.
ENABLE_PASSWORD_AUTH="true"
# Comma-separated emails (case-insensitive) granted the ADMIN role when they
# sign in, via SPID/CIE or password. Only grants, never demotes.
ADMIN_EMAILS=""
# SPID/CIE via OIDC (IAM Proxy Italia). Values below point at the local mock
# (bun run mock-oidc-server.ts); see the README for the real provider.
OIDC_ISSUER="http://127.0.0.1:9090"
OIDC_CLIENT_ID="my-client-id"
OIDC_CLIENT_SECRET="mock-secret"
OIDC_AUTH_SECRET="replace-with-at-least-32-random-characters"
OIDC_REDIRECT_URI="http://127.0.0.1:3003/api/oidc/callback"
OIDC_SCOPES=""
# PA membership check through the Oscar service (lib/oscar.ts). "true" sends each
# new SPID/CIE account (user id, first/last name, PA code and name) to OSCAR_URL;
# Oscar answers on POST /api/oscar/pa-verification. Both calls carry an HS256
# JWT signed with OSCAR_KEY. Anything else keeps it off.
ENABLE_OSCAR_PA_VERIFICATION="false"
OSCAR_URL=""
OSCAR_KEY=""
# Trusted first-party origins for CSRF protection (comma-separated). Not the CORS list.
DOMAINS="http://localhost:3000,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3003"
JWT_SECRET="una-chiave-segreta-lunga-e-casuale"
APP_URL="http://127.0.0.1:3000"
# Mail transport: "resend" (default) or "smtp" (nodemailer, any SMTP connector —
# Mailgun, SES, a corporate relay). Only the selected provider's variables below
# need to be filled in.
MAIL_PROVIDER="resend"
SENDER_EMAIL="no-reply@example.com"
# MAIL_PROVIDER=resend
RESEND_API_KEY=fakeResendApiKey
# MAIL_PROVIDER=smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# "true" forces implicit TLS; port 465 turns it on by itself, 587 uses STARTTLS.
SMTP_SECURE="false"
OPENAI_API_KEY=fakeOpenApiKey