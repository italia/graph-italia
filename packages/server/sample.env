DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres
ROUTES_PREFIX=/api
# CORS allowed origin(s) for the public API. "*" (default) keeps charts embeddable
# anywhere; set a single origin or a comma-separated list to restrict it.
CORS_ORIGIN="*"
# Public chart/dashboard publishing. "false" removes this instance's public
# surface: /charts/show/:id and /dashboards/show/:id stop answering, nothing can
# be set to publish: true, and the webapp hides the publish UI accordingly
# (it reads this value from GET /api/config). Anything else keeps it enabled.
ENABLE_PUBLIC_PUBLISHING="true"
# Trusted first-party origins for CSRF protection (comma-separated). Not the CORS list.
DOMAINS="http://localhost:3000,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3003"
JWT_SECRET="una-chiave-segreta-lunga-e-casuale"
APP_URL="http://127.0.0.1:3000"
# Mail transport: "resend" (default) or "smtp" (nodemailer, any SMTP connector —
# Mailgun, SES, a corporate relay). Only the selected provider's variables below
# need to be filled in.
MAIL_PROVIDER="resend"
SENDER_EMAIL="no-reply@example.com"
# MAIL_PROVIDER=resend
RESEND_API_KEY=fakeResendApiKey
# MAIL_PROVIDER=smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# "true" forces implicit TLS; port 465 turns it on by itself, 587 uses STARTTLS.
SMTP_SECURE="false"
OPENAI_API_KEY=fakeOpenApiKey